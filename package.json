{
	"name": "pi-env",
	"version": "0.1.0",
	"private": true,
	"description": "Load global and trusted project dotenv files into pi.",
	"type": "module",
	"keywords": [
		"pi-package"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Distortedlogic/pi-env.git"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"check": "npm run typecheck && npm run lint && npm test",
		"lint": "biome check .",
		"test": "npm run test:unit && npm run test:e2e",
		"test:e2e": "node --experimental-strip-types --test test/e2e.test.ts",
		"test:unit": "node --experimental-strip-types --test test/unit.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.85.1 <1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/node": "^22.10.0",
		"typescript": "^5.9.0"
	},
	"dependencies": {
		"dotenv": "17.4.2"
	}
}
