{
	"name": "pi-env",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"keywords": [
		"pi-package"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Distortedlogic/pi-env.git"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"check": "npm run typecheck && npm run lint && npm test",
		"format": "biome check --write .",
		"lint": "biome check .",
		"test": "npm run test:unit && npm run test:e2e",
		"test:e2e": "node --import tsx --test test/e2e.test.ts",
		"test:unit": "node --import tsx --test test/unit.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "0.87.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@earendil-works/pi-coding-agent": "0.87.1",
		"@types/node": "22.20.4",
		"tsx": "4.23.15",
		"typescript": "7.0.2"
	},
	"dependencies": {
		"dotenv": "17.4.2"
	}
}
